# ── Payment rails ───────────────────────────────────────────────────────────
# Every paid route accepts USDC on BOTH rails; the client picks one.
# These defaults are the suite's public receive addresses — change them to
# your own to get paid. The server logs a note while the defaults are in use.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ── Networks ────────────────────────────────────────────────────────────────
# EVM network: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta
# Solana RPC used to build the SPL transfer the buyer signs.
# The public RPC is heavily rate-limited — use Helius/Triton/QuickNode in prod.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional devnet RPC for the browser checkout when SOLANA_NETWORK=devnet.
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Facilitator that verifies + settles payments on both rails.
FACILITATOR_URL=https://x402.org/facilitator

# ── Signing ─────────────────────────────────────────────────────────────────
# Secret for HMAC-SHA256 signatures on confirmations and cancellations.
# A development default is baked in — ALWAYS set your own in production.
SIGNING_SECRET=change-me-to-a-long-random-string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4022
# Public origin, used to build the `resource` URL in 402 challenges when the
# server sits behind a proxy. Optional.
# PUBLIC_BASE_URL=https://booking.example.com
# Where appointments + ledger JSON live (created automatically).
DATA_DIR=data
# Your services, hours, and cancellation policy.
SERVICES_CONFIG=config/services.json

# ── Client examples only ────────────────────────────────────────────────────
# Private key of the PAYING wallet for examples/agent-client.ts (EVM rail).
# Fund with base-sepolia USDC: https://faucet.circle.com
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4022
